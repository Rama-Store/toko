<script>
let currentGame = '';
let currentProduct = '';

function openOrder(game, product){
  currentGame = game;
  currentProduct = product;

  document.getElementById('orderTitle').textContent = 'Detail Pesanan';
  document.getElementById('orderProduct').textContent = game + ' • ' + product;
  document.getElementById('gameId').value = '';
  document.getElementById('zoneId').value = '';

  const zoneWrap = document.getElementById('zoneWrap');
  zoneWrap.style.display = game.toLowerCase().includes('mobile legends') ? 'block' : 'none';

  document.getElementById('orderModal').classList.add('show');
  document.getElementById('orderModal').setAttribute('aria-hidden','false');

  setTimeout(() => document.getElementById('gameId').focus(), 100);
}

function closeOrder(){
  document.getElementById('orderModal').classList.remove('show');
  document.getElementById('orderModal').setAttribute('aria-hidden','true');
}

function orderProduct(el){
  const product = el.dataset.product;
  const card = el.closest('.card');
  const game = card ? card.querySelector('h3').textContent.trim() : 'Produk';
  openOrder(game, product);
}

function orderGame(game){
  openOrder(game, 'Top Up');
}

function sendOrder(){
  const id = document.getElementById('gameId').value.trim();

  if(!id){
    alert('Silakan masukkan ID game terlebih dahulu.');
    document.getElementById('gameId').focus();
    return;
  }

  let message = `Halo Rama Store, saya ingin membeli ${currentGame} - ${currentProduct}.\n\n`;
  message += `🆔 ID: ${id}\n`;

  if(currentGame.toLowerCase().includes('mobile legends')){
    const zone = document.getElementById('zoneId').value.trim();

    if(!zone){
      alert('Silakan masukkan Zone ID terlebih dahulu.');
      document.getElementById('zoneId').focus();
      return;
    }

    message += `🌐 ZONE ID: ${zone}\n`;
  }

  message += `\nMohon info langkah pembayarannya.`;

  window.open(
    'https://wa.me/6282337889026?text=' + encodeURIComponent(message),
    '_blank'
  );

  closeOrder();
}

document.getElementById('orderModal').addEventListener('click', function(e){
  if(e.target === this) closeOrder();
});
</script>


<div id="orderModal" class="order-modal" aria-hidden="true">
