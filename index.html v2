    <h2 id="orderTitle">Detail Pesanan</h2>
    <p id="orderProduct" class="order-product"></p>

    <label for="gameId">ID Game</label>
    <input id="gameId" type="text" inputmode="numeric" placeholder="Masukkan ID game">

    <div id="zoneWrap" style="display:none;">
